{
  "name": "ragy",
  "version": "0.1.0-dev.30",
  "description": "Modern RAG System with Multi-Project Support",
  "main": "electron/main.js",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "server": "node --expose-gc server/server.js",
    "dev:all": "concurrently \"npm run dev\" \"npm run server\"",
    "build:server": "esbuild server/server.js --bundle --platform=node --format=esm --target=node22 --banner:js=\"import { createRequire } from 'module'; const require = createRequire(import.meta.url);\" --outfile=dist/server.mjs --external:better-sqlite3 --external:hnswlib-node --external:sharp --external:electron --external:onnxruntime-node --external:onnxruntime-common",
    "electron:dev": "concurrently \"npm run dev\" \"npm run build:server\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:build": "npm run build && npm run build:server && electron-builder",
    "electron:build:win": "npm run build && npm run build:server && electron-builder --win --x64 --publish always",
    "electron:build:mac": "npm run build && npm run build:server && electron-builder --mac",
    "electron:build:linux": "npm run build && npm run build:server && electron-builder --linux",
    "setup": "npm install && cd server/python && pip3 install -r requirements.txt",
    "start": "node --expose-gc server/server.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.69.0",
    "@modelcontextprotocol/sdk": "^1.22.0",
    "@xenova/transformers": "^2.17.2",
    "better-sqlite3": "^12.5.0",
    "cors": "^2.8.5",
    "electron-updater": "^6.1.7",
    "express": "^4.18.2",
    "hnswlib-node": "^3.0.0",
    "lucide-react": "^0.294.0",
    "multer": "^1.4.5-lts.1",
    "openai": "^6.9.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-markdown": "^10.1.0",
    "uuid": "^9.0.1",
    "ws": "^8.14.2",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@vitejs/plugin-react": "^4.2.1",
    "concurrently": "^8.2.2",
    "electron": "33.4.11",
    "electron-builder": "^24.9.1",
    "esbuild": "^0.27.1",
    "jest": "^30.2.0",
    "vite": "^7.2.2",
    "vitest": "^4.0.13",
    "wait-on": "^7.2.0"
  },
  "keywords": [
    "rag",
    "embeddings",
    "vector-database",
    "semantic-search"
  ],
  "author": "",
  "license": "MIT",
  "build": {
    "appId": "com.ragy.app",
    "productName": "RAGy",
    "electronVersion": "33.4.11",
    "npmRebuild": false,
    "buildDependenciesFromSource": false,
    "nodeGypRebuild": false,
    "asar": false,
    "files": [
      "dist/**/*",
      "electron/**/*",
      "server/python/**/*",
      "server/config/**/*",
      "!server/**/*.js",
      "node_modules/**/*",
      "package.json",
      "!node_modules/*/{CHANGELOG.md,README.md,README,readme.md,readme}",
      "!node_modules/*/{test,__tests__,tests,powered-test,example,examples}",
      "!node_modules/*.d.ts",
      "!node_modules/.bin",
      "!**/*.{iml,o,hprof,orig,pyc,pyo,rbc,swp,csproj,sln,xproj}",
      "!.editorconfig",
      "!**/._*",
      "!**/{.DS_Store,.git,.hg,.svn,CVS,RCS,SCCS,.gitignore,.gitattributes}",
      "!**/{__pycache__,thumbs.db,.flowconfig,.idea,.vs,.nyc_output}",
      "!**/{appveyor.yml,.travis.yml,circle.yml}",
      "!**/{npm-debug.log,yarn.lock,.yarn-integrity,.yarn-metadata.json}"
    ],
    "extraResources": [
      {
        "from": "build-resources/python-win",
        "to": "python",
        "filter": [
          "**/*"
        ]
      }
    ],
    "directories": {
      "output": "release",
      "buildResources": "build-resources"
    },
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build-resources/icon.icns"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build-resources/icon.ico",
      "artifactName": "${productName}-Setup-${version}.${ext}"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility",
      "icon": "build-resources/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "installerIcon": "build-resources/icon.ico",
      "uninstallerIcon": "build-resources/icon.ico",
      "deleteAppDataOnUninstall": false
    },
    "compression": "store",
    "publish": {
      "provider": "github",
      "owner": "tomyud1",
      "repo": "ragy-dev-release",
      "releaseType": "release"
    }
  }
}