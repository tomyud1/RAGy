# RAGy Environment Configuration
# ================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control!

# ===========================================
# Server Configuration
# ===========================================
PORT=3001
NODE_ENV=development
# Options: development, production, test

# ===========================================
# AI Provider API Keys
# ===========================================
# These are OPTIONAL - you can also set them via the Settings UI
# The Settings UI stores keys in encrypted local storage
#
# OpenAI (for GPT models)
OPENAI_API_KEY=

# Anthropic (for Claude models)
ANTHROPIC_API_KEY=

# Google Gemini
GEMINI_API_KEY=

# Moonshot (for Kimi models)
MOONSHOT_API_KEY=

# ===========================================
# Python Configuration
# ===========================================
# Path to Python 3 executable (optional, defaults to 'python3')
PYTHON_PATH=python3

# GPU Configuration
# Options: auto, cpu, metal (Apple Silicon), cuda (NVIDIA)
EMBEDDING_DEVICE=auto

# ===========================================
# Processing Configuration
# ===========================================
# Default batch sizes for document processing
DEFAULT_PROCESSING_BATCH_SIZE=4
DEFAULT_VISION_BATCH_SIZE=4

# Maximum tokens per chunk
DEFAULT_MAX_TOKENS=512

# ===========================================
# Storage Paths (optional - defaults are in ./data)
# ===========================================
# DATA_PATH=./data
# UPLOADS_PATH=./uploads
# CONVERSIONS_PATH=./conversions
