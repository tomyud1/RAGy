                1122,
                458
            ],
            "block_id": 2,
            "block_order": null
        },
        {
            "block_label": "chart",
            "block_content": "<table border=1 style='margin: auto; width: max-content;'>\n  <thead><tr><th style='text-align: center;'>Feature</th><th style='text-align: center;'>Description</th></tr></thead>\n  <tbody>\n    <tr><td style='text-align: center;'>Wavenumber</td><td style='text-align: center;'>0 W/cm²</td></tr>\n    <tr><td style='text-align: center;'>T(x)</td><td style='text-align: center;'>40 W/cm²</td></tr>\n    <tr><td style='text-align: center;'>Planet</td><td style='text-align: center;'>Plane wall</td></tr>\n    <tr><td style='text-align: center;'>L</td><td style='text-align: center;'>x</td></tr>\n  </tbody>\n</table>",
            "block_bbox": [
                1103,
                76,
                1580,
                448
            ],
            "block_id": 3,
            "block_order": null
        },
        {
            "block_label": "figure_title",
            "block_content": "<div style=\"text-align: center;\">FIGURE 2–43 Schematic for Example 2–11.</div>\n",
            "block_bbox": [
                1195,
                456,
                1598,
                542
            ],
            "block_id": 4,
            "block_order": null
        },
        {
            "block_label": "text",
            "block_content": "Therefore, the two boundary conditions can be specified at the same boundary, and it is not necessary to specify them at different locations. In fact, the fundamental theorem of linear ordinary differential equations guarantees that a unique solution exists when both conditions are specified at the same location. But no such guarantee exists when the two conditions are specified at different boundaries, as you will see below.",
            "block_bbox": [
                43,
                639,
                1037,
                847
            ],
            "block_id": 5,
            "block_order": 1
        },
        {
            "block_label": "text",
            "block_content": "(b) In this case different heat fluxes are specified at the two boundaries. The application of the boundary conditions gives",
            "block_bbox": [
                32,
                860,
                1034,
                935
            ],
            "block_id": 6,
            "block_order": 2
        },
        {
            "block_label": "display_formula",
            "block_content": " $$ -k\\frac{dT(0)}{dx}=\\dot{q}_{0}\\quad\\rightarrow\\quad-kC_{1}=\\dot{q}_{0}\\quad\\rightarrow\\quad C_{1}=-\\frac{\\dot{q}_{0}}{k} $$ ",
            "block_bbox": [
                223,
                942,
                860,
                1024
            ],
            "block_id": 7,
            "block_order": 3
        },
        {
            "block_label": "text",
            "block_content": "and",
            "block_bbox": [
                23,
                1058,
                94,
                1091
            ],
            "block_id": 8,
            "block_order": 4
        },
        {
            "block_label": "display_formula",
            "block_content": " $$ -k\\frac{dT(L)}{dx}=\\dot{q}_{L}\\quad\\rightarrow\\quad-kC_{1}=\\dot{q}_{L}\\quad\\rightarrow\\quad C_{1}=-\\frac{\\dot{q}_{L}}{k} $$ ",
            "block_bbox": [
                215,
                1086,
                860,
                1165
            ],
            "block_id": 9,
            "block_order": 5
        },
        {
            "block_label": "text",
            "block_content": "Since  $ \\dot{q}_{0} \\neq \\dot{q}_{L} $  and the constant  $ C_{1} $  cannot be equal to two different things at the same time, there is no solution in this case. This is not surprising since this case corresponds to supplying heat to the plane wall from both sides and expecting the temperature of the wall to remain steady (not to change with time). This is impossible.",
            "block_bbox": [
                13,
                1179,
                1032,
                1358
            ],
            "block_id": 10,
            "block_order": 6
        },
        {
            "block_label": "text",
            "block_content": "(c) In this case, the same values for heat flux are specified at the two boundaries. The application of the boundary conditions gives",
            "block_bbox": [
                12,
                1366,
                1029,
                1442
            ],
            "block_id": 11,
            "block_order": 7
        },
        {
            "block_label": "display_formula",
            "block_content": " $$ -k\\frac{dT(0)}{dx}=\\dot{q}_{0}\\quad\\rightarrow\\quad-kC_{1}=\\dot{q}_{0}\\quad\\rightarrow\\quad C_{1}=-\\frac{\\dot{q}_{0}}{k} $$ ",
            "block_bbox": [
                216,
                1440,
                856,
                1526
            ],
            "block_id": 12,
            "block_order": 8
        },
        {
            "block_label": "text",
            "block_content": "and",
            "block_bbox": [
                12,
                1542,
                85,
                1576
            ],
            "block_id": 13,
            "block_order": 9
        },
        {
            "block_label": "display_formula",
            "block_content": " $$ -k\\frac{dT(L)}{dx}=\\dot{q}_{0}\\quad\\rightarrow\\quad-kC_{1}=\\dot{q}_{0}\\quad\\rightarrow\\quad C_{1}=-\\frac{\\dot{q}_{0}}{k} $$ ",
            "block_bbox": [
                216,
                1567,
                858,
                1657
            ],
            "block_id": 14,
            "block_order": 10
        },
        {
            "block_label": "text",
            "block_content": "Thus, both conditions result in the same value for the constant  $ C_{1} $ , but no value for  $ C_{2} $ . Substituting, the specific solution in this case is determined to be",
            "block_bbox": [
                13,
                1656,
                1034,
                1740
            ],
            "block_id": 15,
            "block_order": 11
        },
        {
            "block_label": "display_formula",
            "block_content": " $$ T(x)=-\\frac{\\dot{q}_{0}}{k}x+C_{2} $$ ",
            "block_bbox": [
                415,
                1745,
                671,
                1821
            ],
            "block_id": 16,
            "block_order": 12
        },
        {
            "block_label": "text",
            "block_content": "which is not a unique solution since  $ C_{2} $  is arbitrary.",
            "block_bbox": [
                24,
                1830,
                701,
                1870
            ],
            "block_id": 17,
            "block_order": 13
        }
    ],
