    "parsing_res_list": [
        {
            "block_label": "header",
            "block_content": "102",
            "block_bbox": [
                283,
                0,
                327,
                25
            ],
            "block_id": 0,
            "block_order": null
        },
        {
            "block_label": "header",
            "block_content": "HEAT CONDUCTION EQUATION",
            "block_bbox": [
                120,
                24,
                482,
                60
            ],
            "block_id": 1,
            "block_order": null
        },
        {
            "block_label": "text",
            "block_content": "Differential equation:",
            "block_bbox": [
                139,
                325,
                367,
                362
            ],
            "block_id": 2,
            "block_order": 1
        },
        {
            "block_label": "display_formula",
            "block_content": " $$ \\frac{d}{dr}\\left(r\\frac{dT}{dr}\\right)=0 $$ ",
            "block_bbox": [
                267,
                366,
                420,
                428
            ],
            "block_id": 3,
            "block_order": 2
        },
        {
            "block_label": "text",
            "block_content": "Integrate:",
            "block_bbox": [
                135,
                435,
                248,
                471
            ],
            "block_id": 4,
            "block_order": 3
        },
        {
            "block_label": "display_formula",
            "block_content": " $$ r\\frac{dT}{dr}=C_{1} $$ ",
            "block_bbox": [
                292,
                474,
                404,
                534
            ],
            "block_id": 5,
            "block_order": 4
        },
        {
            "block_label": "text",
            "block_content": "Divide by $r (r \\neq 0)$:",
            "block_bbox": [
                131,
                536,
                334,
                573
            ],
            "block_id": 6,
            "block_order": 5
        },
        {
            "block_label": "display_formula",
            "block_content": " $$ \\frac{dT}{dr}=\\frac{C_{1}}{r} $$ ",
            "block_bbox": [
                300,
                574,
                406,
                636
            ],
            "block_id": 7,
            "block_order": 6
        },
        {
            "block_label": "text",
            "block_content": "Integrate again:",
            "block_bbox": [
                124,
                634,
                302,
                674
            ],
            "block_id": 8,
            "block_order": 7
        },
        {
            "block_label": "display_formula",
            "block_content": " $$ T(r)=C_{1}\\operatorname{In}r+C_{2} $$ ",
            "block_bbox": [
                244,
                687,
                445,
                729
            ],
            "block_id": 9,
            "block_order": 8
        },
        {
            "block_label": "text",
            "block_content": "which is the general solution.",
            "block_bbox": [
                116,
                740,
                425,
                784
            ],
            "block_id": 10,
            "block_order": 9
        },
        {
            "block_label": "paragraph_title",
            "block_content": "## FIGURE 2–51",
            "block_bbox": [
                3,
                899,
                195,
                939
            ],
            "block_id": 11,
            "block_order": 10
        },
        {
            "block_label": "text",
            "block_content": "Assumptions 1 Heat transfer is steady since there is no change with time. 2 Heat transfer is one-dimensional since there is thermal symmetry about the centerline and no variation in the axial direction, and thus  $  T = T(r)  $ . 3 Thermal conductivity is constant. 4 There is no heat generation.",
            "block_bbox": [
                583,
                91,
                1556,
                232
            ],
            "block_id": 12,
            "block_order": 11
        },
        {
            "block_label": "text",
            "block_content": "Basic steps involved in the solution of the steady one-dimensional heat conduction equation in cylindrical coordinates.\n\nProperties The thermal conductivity is given to be  $ k = 20 \\, W/m \\cdot K $ .",
            "block_bbox": [
                0,
                942,
                471,
                1097
            ],
            "block_id": 13,
            "block_order": 12
        },
        {
            "block_label": "text",
            "block_content": "",
            "block_bbox": [
                583,
                233,
                1414,
                270
            ],
            "block_id": 14,
            "block_order": 13
        },
        {
            "block_label": "text",
            "block_content": "Analysis The mathematical formulation of this problem can be expressed as",
            "block_bbox": [
                579,
                269,
                1544,
                309
            ],
            "block_id": 15,
            "block_order": 14
        },
        {
            "block_label": "display_formula",
            "block_content": " $$ \\frac{d}{dr}\\left(r\\frac{dT}{dr}\\right)=0 $$ ",
            "block_bbox": [
                963,
                318,
                1167,
                400
            ],
            "block_id": 16,
            "block_order": 15
        },
        {
            "block_label": "text",
            "block_content": "with boundary conditions",
            "block_bbox": [
                574,
                416,
                900,
                455
            ],
            "block_id": 17,
            "block_order": 16
        },
        {
            "block_label": "display_formula",
            "block_content": " $$ T(r_{1})=T_{1}=150^{\\circ}\\mathrm{C} $$ ",
            "block_bbox": [
                940,
                468,
                1198,
                509
            ],
            "block_id": 18,
            "block_order": 17
        },
        {
            "block_label": "display_formula",
            "block_content": " $$ T(r_{2})=T_{2}=60^{\\circ}\\mathrm{C} $$ ",
            "block_bbox": [
                940,
                514,
                1184,
                555
            ],
            "block_id": 19,
            "block_order": 18
        },
        {
            "block_label": "text",
            "block_content": "Integrating the differential equation once with respect to r gives",
            "block_bbox": [
                571,
                567,
                1374,
                610
            ],
            "block_id": 20,
            "block_order": 19
        },
        {
            "block_label": "display_formula",
            "block_content": " $$ r\\frac{dT}{dr}=C_{1} $$ ",
            "block_bbox": [
                989,
                621,
                1129,
                696
            ],
            "block_id": 21,
            "block_order": 20
        },
        {
            "block_label": "text",
            "block_content": "where  $ C_{1} $  is an arbitrary constant. We now divide both sides of this equation by r to bring it to a readily integrable form,",
            "block_bbox": [
                564,
                706,
                1540,
                785
            ],
            "block_id": 22,
            "block_order": 21
        },
        {
            "block_label": "display_formula",
            "block_content": " $$ \\frac{dT}{dr}=\\frac{C_{1}}{r} $$ ",
            "block_bbox": [
                992,
                797,
                1116,
                876
            ],
            "block_id": 23,
            "block_order": 22
        },
        {
            "block_label": "text",
            "block_content": "Again integrating with respect to r gives (Fig. 2–51)",
            "block_bbox": [
                562,
                888,
                1213,
                931
            ],
            "block_id": 24,
            "block_order": 23
        },
        {
            "block_label": "display_formula",
            "block_content": " $$ T(r)=C_{1}\\ln r+C_{2} $$ ",
            "block_bbox": [
                906,
                945,
                1157,
                986
            ],
            "block_id": 25,
            "block_order": 24
        },
        {
            "block_label": "formula_number",
            "block_content": "(a)",
            "block_bbox": [
                1483,
                954,
                1520,
                987
            ],
            "block_id": 26,
            "block_order": null
        },
        {
            "block_label": "text",
            "block_content": "We now apply both boundary conditions by replacing all occurrences of r and  $ T(r) $  in Eq. (a) with the specified values at the boundaries. We get",
            "block_bbox": [
                559,
                997,
                1528,
                1076
            ],
            "block_id": 27,
            "block_order": 25
        },
        {
            "block_label": "display_formula",
            "block_content": " $$ \\begin{aligned}T(r_{1})&=T_{1}&\\rightarrow&C_{1}\\ln r_{1}+C_{2}=T_{1}\\\\T(r_{2})&=T_{2}&\\rightarrow&C_{1}\\ln r_{2}+C_{2}=T_{2}\\end{aligned} $$ ",
            "block_bbox": [
                818,
                1092,
                1272,
                1179
            ],
            "block_id": 28,
            "block_order": 26
        },
        {
            "block_label": "text",
            "block_content": "which are two equations in two unknowns,  $ C_{1} $  and  $ C_{2} $ . Solving them simultaneously gives",
            "block_bbox": [
                551,
                1190,
                1521,
                1262
            ],
            "block_id": 29,
            "block_order": 27
        },
        {
            "block_label": "display_formula",
            "block_content": " $$ C_{1}=\\frac{T_{2}-T_{1}}{\\ln(r_{2}/r_{1})}\\quad and\\quad C_{2}=T_{1}-\\frac{T_{2}-T_{1}}{\\ln(r_{2}/r_{1})}\\ln r_{1} $$ ",
            "block_bbox": [
                749,
                1264,
                1327,
                1349
            ],
            "block_id": 30,
            "block_order": 28
        },
        {
            "block_label": "text",
            "block_content": "Substituting them into Eq. (a) and rearranging, the variation of temperature within the pipe is determined to be",
            "block_bbox": [
                546,
                1369,
                1516,
                1443
            ],
            "block_id": 31,
            "block_order": 29
        },
        {
            "block_label": "display_formula",
            "block_content": " $$ T(r)=\\frac{\\ln(r/r_{1})}{\\ln(r_{2}/r_{1})}(T_{2}-T_{1})+T_{1} $$ ",
            "block_bbox": [
                830,
                1451,
                1211,
                1533
            ],
            "block_id": 32,
            "block_order": 30
        },
        {
            "block_label": "formula_number",
            "block_content": "(2–58)",
            "block_bbox": [
                1433,
                1479,
                1509,
                1513
            ],
            "block_id": 33,
            "block_order": null
        },
        {
            "block_label": "text",
            "block_content": "The rate of heat loss from the steam is simply the total rate of heat conduction through the pipe, and is determined from Fourier's law to be",
            "block_bbox": [
                542,
                1548,
                1511,
                1622
            ],
            "block_id": 34,
            "block_order": 31
        },
        {
            "block_label": "display_formula",
            "block_content": " $$ \\dot{Q}_{cylinder}=-kA\\frac{dT}{dr}=-k(2\\pi rL)\\frac{C_{1}}{r}=-2\\pi kLC_{1}=2\\pi kL\\frac{T_{1}-T_{2}}{\\ln(r_{2}/r_{1})} $$ ",
            "block_bbox": [
                583,
                1638,
                1399,
                1729
            ],
            "block_id": 35,
            "block_order": 32
        },
        {
            "block_label": "formula_number",
            "block_content": "(2–59)",
            "block_bbox": [
                1432,
                1670,
                1508,
                1704
            ],
            "block_id": 36,
            "block_order": null
        },
        {
            "block_label": "text",
            "block_content": "The numerical value of the rate of heat conduction through the pipe is determined by substituting the given values",
            "block_bbox": [
                543,
                1748,
                1512,
                1824
            ],
            "block_id": 37,
            "block_order": 33
        },
        {
            "block_label": "display_formula",
            "block_content": " $$ \\dot{Q}=2\\pi(20\\mathrm{W/m\\cdot K})(20\\mathrm{m})\\frac{(150-60)^{\\circ}\\mathrm{C}}{\\ln(0.08/0.06)}=786\\mathrm{kW} $$ ",
            "block_bbox": [
                701,
                1845,
                1359,
                1929
            ],
            "block_id": 38,
            "block_order": 34
        }
    ],
