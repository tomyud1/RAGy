            "block_label": "image",
            "block_content": "<div style=\"text-align: center;\"><img src=\"imgs/img_in_image_box_23_75_458_490.jpg\" alt=\"Image\" width=\"27%\" /></div>\n",
            "block_bbox": [
                23,
