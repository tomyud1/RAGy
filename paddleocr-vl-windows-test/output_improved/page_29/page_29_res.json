            ],
            "block_id": 22,
            "block_order": null
        },
        {
            "block_label": "figure_title",
            "block_content": "<div style=\"text-align: center;\">FIGURE 2–55</div>\n",
            "block_bbox": [
                1392,
                679,
                1566,
                715
            ],
            "block_id": 23,
            "block_order": null
        },
        {
            "block_label": "vision_footnote",
            "block_content": "At steady conditions, the entire heat generated in a solid must leave the solid through its outer surface.",
            "block_bbox": [
                1134,
                720,
                1571,
                832
            ],
            "block_id": 24,
            "block_order": null
        }
    ],
